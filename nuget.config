<?xml version="1.0" encoding="utf-8"?>
<!-- Restore only from the official NuGet feed, independent of machine-level settings. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
